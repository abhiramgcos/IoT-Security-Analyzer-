# Environment Configuration for SOC IoT Platform

# Database
POSTGRES_PASSWORD=secure_password_change_in_production

# NVD API Key (Get from: https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key_here

# Traffic Monitoring
TRAFFIC_MODE=monitor  # Options: monitor, gateway
MONITOR_INTERFACE=auto  # auto-detect or specify: wlp0s20f3, eth0, etc.

# Device Scanner
SCAN_INTERVAL=300  # Passive scan interval in seconds

# API Gateway
JWT_SECRET=change_this_secret_key_in_production
API_RATE_LIMIT=100  # requests per minute

# Feature Flags
ENABLE_GATEWAY_MODE=false
ENABLE_SSL_INTERCEPTION=false
ENABLE_FIRMWARE_EMULATION=true
